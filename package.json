{
  "name": "lupin-multiplexer",
  "version": "0.1.0",
  "private": true,
  "description": "Lupin multiplexer notifications UI — TypeScript build infrastructure (Phase 1 scaffolding).",
  "scripts": {
    "build": "bash src/scripts/build-multiplexer.sh",
    "build:watch": "bash src/scripts/build-multiplexer.sh --watch",
    "build:nav": "bash src/scripts/build-nav.sh",
    "build:nav:watch": "bash src/scripts/build-nav.sh --watch",
    "build:diagnostic": "bash src/scripts/build-diagnostic.sh",
    "build:diagnostic:watch": "bash src/scripts/build-diagnostic.sh --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:nav": "tsc --noEmit -p tsconfig.nav.json",
    "typecheck:diagnostic": "tsc --noEmit -p tsconfig.diagnostic.json",
    "lint": "eslint src/lupin_app/static/js/multiplexer/",
    "test": "bash src/scripts/run-js-tests-capped.sh",
    "test:uncapped": "echo 'REFUSED: see package.json test script — uncapped tsx --test OOM-killed a session on 2026-08-23. Use npm test.' && exit 1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "c8": "^10.1.3",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "happy-dom": "^20.9.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "xstate": "^5.31.0"
  }
}
