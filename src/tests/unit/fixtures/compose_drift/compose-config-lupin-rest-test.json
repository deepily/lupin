        },
        {
          "type": "tmpfs",
          "target": "/var/lupin/.venv"
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/alembic.ini",
          "target": "/var/lupin/alembic.ini",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects-data/lupin/dm-corpus",
          "target": "/var/lupin/dm-corpus",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/docker",
          "target": "/var/lupin/docker",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/docker-compose.cloud-gpu.yml",
          "target": "/var/lupin/docker-compose.cloud-gpu.yml",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/docker-compose.yml",
          "target": "/var/lupin/docker-compose.yml",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects-data/lupin/flow-ratio",
          "target": "/var/lupin/flow-ratio",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
