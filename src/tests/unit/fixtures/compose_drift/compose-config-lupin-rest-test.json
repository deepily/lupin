          "target": "/var/lupin/io",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/node_modules",
          "target": "/var/lupin/node_modules",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/package-lock.json",
          "target": "/var/lupin/package-lock.json",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/package.json",
          "target": "/var/lupin/package.json",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/pyproject.toml",
          "target": "/var/lupin/pyproject.toml",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/pytest.ini",
          "target": "/var/lupin/pytest.ini",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/src",
          "target": "/var/lupin/src",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/tsconfig.diagnostic.json",
          "target": "/var/lupin/tsconfig.diagnostic.json",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/tsconfig.json",
          "target": "/var/lupin/tsconfig.json",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/mnt/DATA01/include/www.deepily.ai/projects/lupin/tsconfig.nav.json",
          "target": "/var/lupin/tsconfig.nav.json",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ]
    }
  },
  "volumes": {
    "claude-creds-dev": {
      "name": "lupin_claude-creds-dev",
      "driver": "local",
      "external": false
    },
    "claude-creds-test": {
      "name": "lupin_claude-creds-test",
      "driver": "local",
      "external": false
    }
  }
}