{
  "_comment": "A copy of the hooks key from a dev box's ~/.claude/settings.json (2026-10-07). It is the fleet-side half of the template parity test; no other key of that file is copied.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/register_session.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${PLANNING_IS_PROMPTING_ROOT:-/mnt/DATA01/include/www.deepily.ai/projects/planning-is-prompting}/workflow/scripts/install_context_pressure_tick.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/post_tool_use.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/pre_tool_use.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLANNING_IS_PROMPTING_ROOT/workflow/scripts/memento_record_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLANNING_IS_PROMPTING_ROOT/workflow/scripts/worktree_creation_guard.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLANNING_IS_PROMPTING_ROOT/workflow/scripts/rnd_write_guard.py\" --mode pretooluse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/stop.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/notification.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/user_prompt_submit.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/session_end.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$LUPIN_ROOT/.venv/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/permission_request.py\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
