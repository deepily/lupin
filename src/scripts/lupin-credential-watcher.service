# lupin-credential-watcher.service — keeps the Lupin containers on a live OAuth token.
#
# WHY THIS EXISTS (store row c7c60896, Rick's request 2026-08-01):
# Claude Code's access token lives exactly 8 hours and is REPLACED on refresh,
# minting a new inode. The host follows it in milliseconds. A docker single-file
# bind, resolved at container start, does not — so lupin-rest-dev and
# lupin-rest-test strand on a dead token ~3x/day and every bounded-CC path in
# them (podcast, BFE, TFE, deep research, presentation) goes dark until a human
# notices and restarts them.
#
# WHY A WATCHER RATHER THAN THE TIMER THAT WAS ASKED FOR:
# the refresh fires 8 hours after the LAST refresh, which moves whenever the host
# happens to make a call at a different hour. A fixed schedule drifts and then
# does the worst of both things — it restarts while the token is still good (a
# free outage on the fleet's notify channel) and it sleeps through the hours
# after one actually died. This fires on the event itself, so it is never early
# and never late.
#
# ⚠️ THIS IS A BRIDGE, NOT THE FIX. The fix is the dedicated-directory mount in
# c7c60896: a directory bind resolves through on every open, so containers see
# the current credential with NO restart at all. When that lands:
#     systemctl --user disable --now lupin-credential-watcher.service
# and delete this unit. Do not maintain it past its purpose.
#
# WHAT IT TOUCHES — read this before leaving it enabled.
#   :7999  RESTARTED, unattended, via src/scripts/bounce-dev-server.sh — so the
#          fleet gets the ack-confirmed warning and the server emits its own
#          all-clear. Recovery is then PROVEN with a live `claude -p "reply PONG"`,
#          never `claude auth status` (which parses a local token's shape with no
#          server round-trip and reported success against a revoked credential).
#   :8000  NOT TOUCHED. Reported only, with the one-line human remedy in the log.
#
# WHY :8000 IS EXCLUDED (Krishna 🦚, pre-commit review): :8000's rule defines
# verified-IDLE as nothing RUNNING **and nothing SCHEDULED**. This process can
# see the first (`docker exec ps -ef`) and not the second (reading the queue
# needs a JWT it does not hold). Rick's 2026-08-01 "anyone may bounce within
# reason" grant covers :7999 ONLY. The first version of this service restarted
# :8000 on process-idle alone — an unattended actor clearing a bar the codebase
# sets higher. Do not add it back; a regression test asserts the helper is gone.
#
# OFF SWITCH:   systemctl --user stop    lupin-credential-watcher.service
# DISABLE:      systemctl --user disable --now lupin-credential-watcher.service
# WATCH IT:     journalctl --user -u lupin-credential-watcher.service -f
# PROVE IT SEES: <root>/src/scripts/credential-refresh-watcher.py --self-test

[Unit]
Description=Lupin credential watcher — re-points containers when the host OAuth token is refreshed
Documentation=file:///mnt/DATA01/include/www.deepily.ai/projects/lupin/src/scripts/credential-refresh-watcher.py
After=network.target docker.service

[Service]
Type=exec
# The single deploy-time value to confirm on a new host; everything downstream
# derives from it (same convention as lupin-arbiter-app.service).
Environment=LUPIN_ROOT=/mnt/DATA01/include/www.deepily.ai/projects/lupin
# Explicit project-venv interpreter — systemd --user PATH is minimal and a bare
# `python` would resolve to system python, which cannot import cosa.
ExecStart=/mnt/DATA01/include/www.deepily.ai/projects/lupin/.venv/bin/python \
          /mnt/DATA01/include/www.deepily.ai/projects/lupin/src/scripts/credential-refresh-watcher.py
Restart=always
RestartSec=30
# A restart of THIS service must never bounce the fleet: the watcher treats its
# first observation as a baseline and refuses to act on it, so systemd churn
# cannot turn into container churn. Pinned by
# test_credential_watch.py::test_first_observation_does_not_fire.
TimeoutStopSec=30

[Install]
WantedBy=default.target
