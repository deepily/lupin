# src/scripts/cloud-run-model-server.env.example
#
# Model-server-specific overrides for cloud-run-model-server-deploy.sh.
# Copy to cloud-run-model-server.env (git-ignored) and edit as needed:
#
#   cp src/scripts/cloud-run-model-server.env.example src/scripts/cloud-run-model-server.env
#
# The deploy script sources the SHARED cloud-run.env (project/region/registry)
# FIRST via cloud-run-config.sh, then layers this file on top. Any value may
# instead be supplied directly as an environment variable on the command line.
#
# GCP project/region/registry live in cloud-run.env (NOT here) — see
# cloud-run.env.example.

# --- Scale-to-zero ----------------------------------------------------------
MIN="${MIN:-0}"                                       # min-instances; 0 = scale-to-zero (overnight free)
                                                      # set to 1 to keep one instance warm (no cold start)

# --- Cloud Run resource limits ---------------------------------------------
MS_MEMORY="${MS_MEMORY:-32Gi}"                        # container memory limit
MS_CPU="${MS_CPU:-8}"                                 # vCPU count (L4 services need >= 4)
MS_PORT="${MS_PORT:-7998}"                            # container listen port
MS_TIMEOUT="${MS_TIMEOUT:-300}"                       # request timeout seconds
MS_INGRESS="${MS_INGRESS:-internal}"                  # internal | all (internal = VPC-only; design rec)

# --- Secret Manager ---------------------------------------------------------
MS_SECRET_NAME="${MS_SECRET_NAME:-lupin-notification-api-key}"   # secret holding the ck_live_* X-API-Key

# --- Model identifiers (baked into the image; passed as env for redeploy) ---
LUPIN_MODEL_SERVER_DEVICE="${LUPIN_MODEL_SERVER_DEVICE:-cuda:0}"                       # hard rule: Lupin models always cuda:0
LUPIN_MODEL_SERVER_WHISPER_ID="${LUPIN_MODEL_SERVER_WHISPER_ID:-distil-whisper/distil-large-v3}"
LUPIN_MODEL_SERVER_CODE_EMBED="${LUPIN_MODEL_SERVER_CODE_EMBED:-nomic-ai/CodeRankEmbed}"
LUPIN_MODEL_SERVER_PROSE_EMBED="${LUPIN_MODEL_SERVER_PROSE_EMBED:-nomic-ai/nomic-embed-text-v1.5}"
LUPIN_MODEL_SERVER_API_KEY_NAME="${LUPIN_MODEL_SERVER_API_KEY_NAME:-notification-api-claude-code-dev}"
