# src/scripts/cloud-run.env.example
#
# Copy to cloud-run.env (git-ignored) and fill in. All four cloud-run-*.sh
# scripts source cloud-run-config.sh, which reads this file.
#
#   cp src/scripts/cloud-run.env.example src/scripts/cloud-run.env
#
# Any value may instead be supplied directly as an environment variable.

LUPIN_GCP_PROJECT_ID="${LUPIN_GCP_PROJECT_ID:-}"                       # REQUIRED — no sandbox default (unset => scripts abort)
LUPIN_GCP_REGION="${LUPIN_GCP_REGION:-us-central1}"                    # straw-man default (D3)
LUPIN_GCP_REGISTRY="${LUPIN_GCP_REGISTRY:-us-central1-docker.pkg.dev}" # Artifact Registry host (gcr.io retired)
LUPIN_GCP_AR_REPO="${LUPIN_GCP_AR_REPO:-lupin}"                        # Artifact Registry repo name
