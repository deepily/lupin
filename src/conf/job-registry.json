      "cron_log": "{home}/.lupin/logs/worktree-hygiene-report.log",
      "clean_exit_codes": [
        0,
        1
      ]
    },
    {
      "job": "disk-report",
      "enabled_key": "cron job disk-report enabled",
      "catalog": "L6",
