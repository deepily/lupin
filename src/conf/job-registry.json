      "clean_exit_codes": [
        0,
        1
      ]
    },
    {
      "job": "disk-report",
      "enabled_key": "cron job disk-report enabled",
      "catalog": "L6",
      "title": "Disk report",
      "description": "Each week this counts what the fleet leaves behind on disk, such as logs and temporary files. It prints numbers, not a verdict, so growth is noticed before the disk fills.",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "0 19 * * 0"
