{
  "schema": "job-registry/1",
  "defaults": {
    "grace_minutes": 30,
    "notify_interval_minutes": 30,
    "window_days": 7,
    "growth_min_items": 5,
    "growth_min_percent": 5,
    "lock_stale_seconds": 10800,
    "run_env": {
      "LUPIN_ROOT": "{root}",
      "PYTHONPATH": "{root}/src",
      "LUPIN_CONFIG_MGR_CLI_ARGS": "config_path=/src/conf/lupin-app.ini splainer_path=/src/conf/lupin-app-splainer.ini config_block_id=Lupin:+Development",
      "DEEPILY_DATA_DIR": "{deepily_data}",
      "COSA_VOICE_MANAGERS__LUPIN": "Cheech, Mr. Radio"
    },
    "owner_note": "owner_confirmed true means Rick confirmed the owner on 23 Nov 2026 (row 967302fd); the job watcher files a failure row to this owner. A new job starts false until he confirms it (Cheech, 2026-11-07; updated 2026-11-23)",
    "schedule_note": "A job with cron_tag takes its schedule from the installed crontab lines that end with # <tag>; the schedule here is the fallback when none is installed or the crontab cannot be read; the duplicate-check fallback is the three lines installed on 2026-11-07, which any hourly run also covers; a job with cron_managed true has its lines written by lupin_mcp.cron_generate from this entry, and cron_replaces names hand-written lines its install removes"
  },
  "jobs": [
    {
      "job": "duplicate-check",
      "enabled_key": "cron job duplicate-check enabled",
      "catalog": "L5",
      "title": "Duplicate check",
      "description": "Several times a day this looks at the new functions and classes added to the code and asks a model whether the same thing already exists elsewhere. It keeps a count of how many are still waiting to be judged and files a task when it finds a real duplicate.",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "0 10-22 * * *"
        },
        {
          "after_boot_seconds": 300
        }
      ],
      "summary_path": "{code_health}/duplicate-check-daily/job-summary.json",
      "scan_debt": true,
      "fix_debt": true,
      "fix_debt_key": "prefix:epic:dupcheck-",
      "detail_link": "/app/duplicate-check",
      "lock_path": "{code_health}/duplicate-check-daily/run.lock",
      "rows": [
        {
          "id": "350d43c8",
          "title": "Duplicate check run lock",
          "href": null
        },
        {
          "id": "0d23e394",
          "title": "Duplicate-check status page",
          "href": null
        }
      ],
      "evidence": [
        {
          "label": "Run ledger",
          "path": "code-health/duplicate-check-daily/runs.jsonl",
          "href": null
        },
        {
          "label": "Daily log",
          "path": "code-health/duplicate-check-daily/daily.log",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{python}",
          "-m",
          "lupin_mcp.duplicate_check_daily",
          "--adaptive",
          "--branch",
          "auto",
          "--claude-cli-path",
          "{home}/.local/bin/claude",
          "--trigger",
          "hand"
        ],
        "env": {}
      },
      "cron_tag": "duplicate-check-daily",
      "cron_managed": true,
      "cron_log": "{code_health}/duplicate-check-daily/daily.log",
      "own_summary": true,
      "owner_confirmed": true
    },
    {
      "job": "wiki-librarian",
      "enabled_key": "cron job wiki-librarian enabled",
      "catalog": "L1",
      "title": "Wiki librarian",
      "description": "Each morning this checks the documentation pages against the code and flags pages that have fallen out of step. It turns what it finds into tasks and saves a list of searches that found nothing.",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "17 10 * * *"
        },
        {
          "after_boot_seconds": 120
        }
      ],
      "summary_path": "{data}/librarian/job-summary.json",
      "scan_debt": true,
      "fix_debt": true,
      "rows": [
        {
          "id": "791bf720",
          "title": "Wiki librarian export fix",
          "href": null
        }
      ],
      "evidence": [
        {
          "label": "Log",
          "path": "librarian/librarian.log",
          "href": null
        },
        {
          "label": "Tick state",
          "path": "librarian/tick-state.json",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{python}",
          "-m",
          "cosa.repo.symindex.librarian_tick"
        ],
        "env": {}
      },
      "cron_tag": "wiki-librarian-tick",
      "cron_managed": true,
      "cron_log": "{data}/librarian/librarian.log",
      "own_summary": true,
      "owner_confirmed": true
    },
    {
      "job": "reuse-behaviour",
      "enabled_key": "cron job reuse-behaviour enabled",
      "catalog": "L4",
      "title": "Reuse-behaviour page",
      "description": "Each week this builds a page that counts how the fleet used the reuse checks: lookups made, outcome lines refused and audits run. It covers the last full Monday-to-Sunday week, skips a week whose page is already saved, and only reads records and writes the page.",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "0 18 * * *"
        },
        {
          "after_boot_seconds": 360
        }
      ],
      "summary_path": "{root}/io/jobs/reuse-behaviour/job-summary.json",
      "rows": [
        {
          "id": "804838d4",
          "title": "Reuse-behaviour cron fix",
          "href": null
        }
      ],
      "evidence": [
        {
          "label": "Log",
          "path": "behaviour/weekly.log",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{python}",
          "-m",
          "lupin_mcp.reuse_behaviour",
          "--write",
          "--skip-if-saved"
        ],
        "env": {}
      },
      "cron_tag": "reuse-behaviour-weekly",
      "cron_managed": true,
      "cron_log": "{data}/behaviour/weekly.log",
      "own_summary": true,
      "owner_confirmed": true
    },
    {
      "job": "vector-refresh",
      "enabled_key": "cron job vector-refresh enabled",
      "catalog": "L2",
      "title": "Vector refresh (also rebuilds the symbol index)",
      "description": "Each day this keeps the code search up to date: it refreshes the list of functions and classes, writes a plain-English purpose line for any that lacks one, and rebuilds the search data when something changed. Without it, the \"does this already exist?\" search goes stale.",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "47 10 * * *"
        },
        {
          "after_boot_seconds": 240
        }
      ],
      "summary_path": "{data}/refresh/job-summary.json",
      "scan_debt": true,
      "lock_path": "{data}/vector-build.lock",
      "evidence": [
        {
          "label": "Log",
          "path": "refresh/refresh.log",
          "href": null
        },
        {
          "label": "State",
          "path": "refresh/refresh-state.json",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{root}/src/scripts/reuse-vector-refresh.sh"
        ],
        "env": {
          "REUSE_VECTOR_REFRESH_PYTHON": "{python}",
          "REUSE_VECTOR_REFRESH_ENV": "{home}/.lupin/reuse-vector-refresh.env"
        }
      },
      "owner_confirmed": true,
      "cron_tag": "reuse-vector-refresh",
      "cron_managed": true,
      "cron_log": "{data}/refresh/refresh.log",
      "own_summary": true
    },
    {
      "job": "shadow-audit",
      "enabled_key": "cron job shadow-audit enabled",
      "catalog": "L3",
      "title": "Shadow audit",
      "description": "Each day this takes the audits that are waiting and re-runs those past reuse lookups through the full search, to check the quick answer was right. It stops at a limit per run, a weekly limit and a lifetime limit on how much it may spend, and does nothing while switched off.",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "37 11 * * *"
        },
        {
          "after_boot_seconds": 300
        }
      ],
      "summary_path": "{data}/shadow-audit/job-summary.json",
      "scan_debt": true,
      "evidence": [
        {
          "label": "Log",
          "path": "shadow-audit/shadow-audit.log",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{root}/src/scripts/reuse-shadow-audit.sh"
        ],
        "env": {
          "LUPIN_REUSE_JEV_PACK_SIZE": "50",
          "REUSE_SHADOW_AUDIT_PYTHON": "{python}"
        }
      },
      "owner_confirmed": true,
      "cron_tag": "reuse-shadow-audit",
      "cron_managed": true,
      "cron_log": "{data}/shadow-audit/shadow-audit.log"
    },
    {
      "job": "context-tick",
      "enabled_key": "cron job context-tick enabled",
      "switch_reader": "lupin_mcp.job_run:switched_on",
      "catalog": "P1",
      "title": "Context-pressure tick (fleet)",
      "description": "Every ten minutes this checks how full each working session's memory is. When one is past its limit, it tells that session, its manager and Rick, so the session can be restarted before it gets confused.",
      "owner": "maria",
      "schedule": [
        {
          "cron": "9,19,29,39,49,59 * * * *"
        }
      ],
      "summary_path": "{root}/io/jobs/context-tick/job-summary.json",
      "audience": [
        "managers"
      ],
      "owner_confirmed": true,
      "cron_exclusion_reason": "planning-is-prompting owns this script and its fleet timer install (slot-fleet tag), so it is not a Lupin line to generate. Its installer writes the line as cron-job.sh context-tick cron -- <tick>, so job_run records each run; there is no run block, so the page offers no Run now (Rick, decision 317d5101, 2026-11-14)"
    },
    {
      "job": "doc-parity-tick",
      "enabled_key": "cron job doc-parity-tick enabled",
      "catalog": "P3",
      "title": "Doc-parity tick",
      "description": "Each morning this checks that paragraphs which should say the same thing in two documents still do. It prints nothing when they match and speaks up only when one copy has drifted.",
      "owner": "maria",
      "schedule": [
        {
          "cron": "30 7 * * *"
        },
        {
          "after_boot_seconds": 180
        }
      ],
      "summary_path": "{root}/io/jobs/doc-parity-tick/job-summary.json",
      "run": {
        "argv": [
          "{pip}/workflow/scripts/doc-parity-tick.sh"
        ],
        "env": {}
      },
      "owner_confirmed": true,
      "cron_tag": "doc-parity-tick",
      "cron_managed": true,
      "cron_log": "{home}/.lupin/logs/doc-parity-tick.log",
      "cron_replaces": [
        "workflow/scripts/doc-parity-tick.sh"
      ]
    },
    {
      "job": "worktree-census",
      "enabled_key": "cron job worktree-census enabled",
      "catalog": "P4",
      "title": "Worktree census",
      "description": "Each week this lists the temporary working copies and branches that have been left behind: stale ones, ones git says are gone, and ones already merged. It only reports; a person decides what to delete.",
      "owner": "maria",
      "schedule": [
        {
          "cron": "0 13 * * 1"
        }
      ],
