        "env": {}
      },
      "owner_confirmed": false,
      "cron_exclusion_reason": "planning-is-prompting owns this script and its fleet timer install (slot-fleet tag), so it is not a Lupin line to generate"
    },
    {
      "job": "doc-parity-tick",
      "enabled_key": "cron job doc-parity-tick enabled",
      "catalog": "P3",
      "title": "Doc-parity tick",
      "owner": "cheech",
