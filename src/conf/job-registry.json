      "cron_tag": "reuse-shadow-audit",
      "cron_managed": true,
      "cron_log": "{data}/shadow-audit/shadow-audit.log"
    },
    {
      "job": "context-tick",
      "catalog": "P1",
      "title": "Context-pressure tick (fleet)",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "9,19,29,39,49,59 * * * *"
