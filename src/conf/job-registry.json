{
  "schema": "job-registry/1",
  "defaults": {
    "grace_minutes": 30,
    "notify_interval_minutes": 30,
    "window_days": 7,
    "growth_min_items": 5,
    "growth_min_percent": 5,
    "lock_stale_seconds": 10800,
    "run_env": {
      "LUPIN_ROOT": "{root}",
      "PYTHONPATH": "{root}/src",
      "LUPIN_CONFIG_MGR_CLI_ARGS": "config_path=/src/conf/lupin-app.ini splainer_path=/src/conf/lupin-app-splainer.ini config_block_id=Lupin:+Development",
      "DEEPILY_DATA_DIR": "{deepily_data}",
      "COSA_VOICE_MANAGERS__LUPIN": "Cheech, Mr. Radio"
    },
    "owner_note": "owner_confirmed false means the owner is cheech by default and no open row names another seat (Cheech, 2026-11-07)",
    "schedule_note": "A job with cron_tag takes its schedule from the installed crontab lines that end with # <tag>; the schedule here is the fallback when none is installed or the crontab cannot be read; the duplicate-check fallback is the three lines installed on 2026-11-07, which any hourly run also covers; a job with cron_managed true has its lines written by lupin_mcp.cron_generate from this entry, and cron_replaces names hand-written lines its install removes"
  },
  "jobs": [
    {
      "job": "duplicate-check",
      "enabled_key": "cron job duplicate-check enabled",
      "catalog": "L5",
      "title": "Duplicate check",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "0 10-22 * * *"
        },
        {
          "after_boot_seconds": 300
        }
      ],
      "summary_path": "{code_health}/duplicate-check-daily/job-summary.json",
      "scan_debt": true,
      "fix_debt": true,
      "fix_debt_key": "prefix:epic:dupcheck-",
      "detail_link": "/app/duplicate-check",
      "lock_path": "{code_health}/duplicate-check-daily/run.lock",
      "rows": [
        {
          "id": "350d43c8",
          "title": "Duplicate check run lock",
          "href": null
        },
        {
          "id": "0d23e394",
          "title": "Duplicate-check status page",
          "href": null
        }
      ],
      "evidence": [
        {
          "label": "Run ledger",
          "path": "code-health/duplicate-check-daily/runs.jsonl",
          "href": null
        },
        {
          "label": "Daily log",
          "path": "code-health/duplicate-check-daily/daily.log",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{python}",
          "-m",
          "lupin_mcp.duplicate_check_daily",
          "--adaptive",
          "--branch",
          "auto",
          "--claude-cli-path",
          "{home}/.local/bin/claude",
          "--trigger",
          "hand"
        ],
        "env": {}
      },
      "cron_tag": "duplicate-check-daily",
      "cron_managed": true,
      "cron_log": "{code_health}/duplicate-check-daily/daily.log",
      "own_summary": true
    },
    {
      "job": "wiki-librarian",
      "enabled_key": "cron job wiki-librarian enabled",
      "catalog": "L1",
      "title": "Wiki librarian",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "17 10 * * *"
        },
        {
          "after_boot_seconds": 120
        }
      ],
      "summary_path": "{data}/librarian/job-summary.json",
      "scan_debt": true,
      "fix_debt": true,
      "rows": [
        {
          "id": "791bf720",
          "title": "Wiki librarian export fix",
          "href": null
        }
      ],
      "evidence": [
        {
          "label": "Log",
          "path": "librarian/librarian.log",
          "href": null
        },
        {
          "label": "Tick state",
          "path": "librarian/tick-state.json",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{python}",
          "-m",
          "cosa.repo.symindex.librarian_tick"
        ],
        "env": {}
      },
      "cron_tag": "wiki-librarian-tick",
      "cron_managed": true,
      "cron_log": "{data}/librarian/librarian.log",
      "own_summary": true
    },
    {
      "job": "reuse-behaviour",
      "enabled_key": "cron job reuse-behaviour enabled",
      "catalog": "L4",
      "title": "Reuse-behaviour page",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "0 18 * * *"
        },
        {
          "after_boot_seconds": 360
        }
      ],
      "summary_path": "{root}/io/jobs/reuse-behaviour/job-summary.json",
      "rows": [
        {
          "id": "804838d4",
          "title": "Reuse-behaviour cron fix",
          "href": null
        }
      ],
      "evidence": [
        {
          "label": "Log",
          "path": "behaviour/weekly.log",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{python}",
          "-m",
          "lupin_mcp.reuse_behaviour",
          "--write",
          "--skip-if-saved"
        ],
        "env": {}
      },
      "cron_tag": "reuse-behaviour-weekly",
      "cron_managed": true,
      "cron_log": "{data}/behaviour/weekly.log",
      "own_summary": true
    },
    {
      "job": "vector-refresh",
      "enabled_key": "cron job vector-refresh enabled",
      "catalog": "L2",
      "title": "Vector refresh (also rebuilds the symbol index)",
      "owner": "cheech",
      "schedule": [
        {
          "cron": "47 10 * * *"
        },
        {
          "after_boot_seconds": 240
        }
      ],
      "summary_path": "{data}/refresh/job-summary.json",
      "scan_debt": true,
      "lock_path": "{data}/vector-build.lock",
      "evidence": [
        {
          "label": "Log",
          "path": "refresh/refresh.log",
          "href": null
        },
        {
          "label": "State",
          "path": "refresh/refresh-state.json",
          "href": null
        }
      ],
      "run": {
        "argv": [
          "{root}/src/scripts/reuse-vector-refresh.sh"
        ],
        "env": {
          "REUSE_VECTOR_REFRESH_PYTHON": "{python}",
          "REUSE_VECTOR_REFRESH_ENV": "{home}/.lupin/reuse-vector-refresh.env"
        }
      },
      "owner_confirmed": false,
      "cron_tag": "reuse-vector-refresh",
      "cron_managed": true,
      "cron_log": "{data}/refresh/refresh.log",
      "own_summary": true
    },
    {
      "job": "shadow-audit",
      "enabled_key": "cron job shadow-audit enabled",
      "catalog": "L3",
      "title": "Shadow audit",
      "owner": "cheech",
