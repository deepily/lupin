        "sweep-hook-logs.sh"
      ],
      "cron_tag": "hook-log-sweep"
    },
    {
      "job": "io-tmp-sweep",
      "enabled_key": "cron job io-tmp-sweep enabled",
      "catalog": "L8",
      "title": "io/tmp sweep",
