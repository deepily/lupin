{
  "_comment": "Canonical cosa-voice Claude Code hooks block. Verbatim, env-var-relative so it ports to any host. The python hooks resolve their interpreter from ${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv} \u2014 the operator-owned CC venv install-cosa-voice.sh provisions; LUPIN_CC_VENV defaults to $LUPIN_ROOT/.venv (dev box) and is overridden per-machine (e.g. the GCP VM, where $LUPIN_ROOT/.venv symlinks to the arbiter's venv). Installed into ~/.claude/settings.json by install-cosa-voice.sh. Source of truth \u2014 do NOT hardcode absolute paths here.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/register_session.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/post_tool_use.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/pre_tool_use.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLANNING_IS_PROMPTING_ROOT/workflow/scripts/memento_record_guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/stop.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/notification.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/user_prompt_submit.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/session_end.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LUPIN_CC_VENV:-$LUPIN_ROOT/.venv}/bin/python3\" \"$LUPIN_ROOT/src/lupin_cli/claude_code/hooks/permission_request.py\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}