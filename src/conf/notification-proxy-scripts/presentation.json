{
    "profile_name"  : "presentation",
    "description"   : "Q&A script for presentation generator expediter questions",
    "sender_ids"    : [ "arg.expeditor@lupin.deepily.ai" ],
    "entries" : [
        {
            "question_pattern" : "Which document should I convert to a presentation? Describe it or say the filename.",
            "answer"           : "/tmp/mock-source-document.md",
            "arg_name"         : "source",
            "response_types"   : [ "open_ended", "open_ended_batch" ]
        },
        {
            "question_pattern" : "How long should the presentation be in minutes? Say a number, or 'default' for 15 minutes.",
            "answer"           : "default",
            "arg_name"         : "target_duration_minutes",
            "response_types"   : [ "open_ended", "open_ended_batch" ]
        },
        {
            "question_pattern" : "Who is the target audience? Options: beginner, general, expert, or academic.",
            "answer"           : "general",
            "arg_name"         : "audience",
            "response_types"   : [ "open_ended", "open_ended_batch", "multiple_choice" ]
        },
        {
            "question_pattern" : "Any additional context about the audience? Say 'none' to skip.",
            "answer"           : "none",
            "arg_name"         : "audience_context",
            "response_types"   : [ "open_ended", "open_ended_batch" ]
        },
        {
            "question_pattern" : "Which presentation theme? Say 'default' or a theme name.",
            "answer"           : "default",
            "arg_name"         : "theme",
            "response_types"   : [ "open_ended", "open_ended_batch" ]
        },
        {
            "question_pattern" : "Would you like to proceed with these settings?",
            "answer"           : "yes",
            "arg_name"         : "confirmation",
            "response_types"   : [ "yes_no" ]
        }
    ]
}
