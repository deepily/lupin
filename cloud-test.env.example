# cloud-test.env.example — template for the GCP test VM deploy env.
#
# Copy to `cloud-test.env` ON THE VM (git-ignored) and fill in, then:
#   docker compose -f docker-compose.cloud-test.yml --env-file cloud-test.env up -d
#
# NONE of these are baked into the image or the compose file — they are the
# per-deploy values resolved at bring-up (Phase E). See:
#   src/rnd/v0.1.8/2026.05.30-gcp-deployment/2026.06.10-m2-arbiter-ride-along-and-vm-cutover.md §6
#
# SECURITY: cloud-test.env holds the DB password — keep it git-ignored, mode 600,
# owned by the deploy user. Never commit a filled-in copy.

# --- Cloud SQL (the Auth-Proxy sidecar dials this private-IP instance) ---------
# From the Lupin terraform output / M1 record.
CLOUD_SQL_CONNECTION_NAME=<your-gcp-project-id>:us-central1:lupin-pg16-test

# --- DB credentials -----------------------------------------------------------
# Fetch the password at deploy time (do NOT hardcode a real value here):
#   DB_PASSWORD=$(gcloud secrets versions access latest --secret=lupin-db-password)
DB_PASSWORD=__from_secret_manager_lupin-db-password__
DB_USER=lupin_app
DB_NAME=lupin_db_test

# --- Image (Artifact Registry path after Phase D2 push) -----------------------
LUPIN_IMAGE=us-central1-docker.pkg.dev/<your-gcp-project-id>/lupin-images/lupin:1.1.0
LUPIN_MODEL_SERVER_TAG=0.1.0

# --- Claude Code OAuth (the one human step — Rick's `claude setup-token`) ------
# Seed from the long-lived token generated on Rick's home box (browser present).
# Read by the Agent SDK inside lupin-rest for bounded-CC jobs (zero per-token cost).
# CLAUDE_CODE_OAUTH_TOKEN=__from_rick_setup-token__
