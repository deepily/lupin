    "MD022": false,
    "MD024": false,
    "MD026": false,
    "MD028": false,
    "MD029": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD041": false,
    "MD049": false,
    "MD058": false,
    "MD060": false
  },
  "noBanner": true,
