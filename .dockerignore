# PostgreSQL data directories (Docker volumes - should not be in image)
# Multiple patterns + globs because BuildKit's sender will try to open the dir
# during context evaluation; mode 700 owned by postgres-in-container is unreadable
# by the host build user. Strongest match wins; explicit + ** + glob covers all
# code paths in BuildKit + classic builder.
src/conf/long-term-memory/postgresql-dev-data
src/conf/long-term-memory/postgresql-dev-data/
src/conf/long-term-memory/postgresql-dev-data/**
**/postgresql-dev-data
**/postgresql-dev-data/
**/postgresql-dev-data/**
src/conf/long-term-memory/*.lancedb.backup-*

# Lance DB — NEVER baked into the image (was 41 GB of dead weight in lupin:0.9.0).
# Sourced at runtime from the host bind-mount in docker-compose.yml (./src),
# or from GCS-FUSE in production (Tier 3, separate PR).
src/conf/long-term-memory/lupin.lancedb
src/conf/long-term-memory/lupin.lancedb/
src/conf/long-term-memory/lupin.lancedb/**
**/lupin.lancedb
**/lupin.lancedb/**

# Runtime bind-mount dirs (container writes here; never COPY'd into image)
# Excluded to avoid "permission denied" on container-owned files during build context send.
io/
io/**
src/rnd/
src/rnd/**
src/tests/
src/tests/**
src/lupin-plugin-firefox/
src/lupin-plugin-firefox/**
src/lupin-mobile/
src/lupin-mobile/**
src/ephemera/
src/ephemera/**

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
# Bare-name patterns match only at the root; use **/ for nested venvs
# (e.g., src/cosa/.venv is a host-only 8.6 GB venv never used in the image).
.venv
venv/
ENV/
env/
**/.venv/
**/.venv
**/venv/

# IDE (top-level + nested)
.vscode/
.idea/
*.swp
*.swo
**/.idea/
**/.vscode/
**/.claude/

# Git (top-level + any nested repos like src/cosa/.git)
.git/
.gitignore
**/.git/
**/.git

# Testing (top-level + nested)
.pytest_cache/
.coverage
htmlcov/
.tox/
**/.pytest_cache/

# Build artifacts
*.egg-info/
dist/
build/

# Logs
*.log
logs/

# Local development files
.env
.env.local
*.local

# Documentation builds
docs/_build/

# OS files
.DS_Store
Thumbs.db
